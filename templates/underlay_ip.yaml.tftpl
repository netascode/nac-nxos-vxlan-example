# Underlay IP: BFD, loopback1 (VTEP), fabric interfaces
#
# Variables:
#   leaf_id or spine_id           Leaf or spine number (1, 2, ...)
#
# Optional variables:
#   vtep_prefix                   First three octets of the leaf loopback1 (VTEP) address (default: 10.1.2)
#   leaf_fabric_interface_start   First leaf uplink port on module 1 (default: 1)
#   spine_fabric_module_start     First spine module with leaf-facing ports (default: 1)
#   spine_fabric_interface_start  First leaf-facing port per spine module (default: 1)
#   spine_fabric_interface_max    Last leaf-facing port per spine module (default: 64)

feature:
  bfd: true

interfaces:
  loopbacks:
%{ for self in [for d in GLOBAL.devices : d if contains(d.device_groups, "LEAFS") && d.variables.leaf_id == try(leaf_id, -1)] }
    - id: 1
      ip:
        address: ${try(vtep_prefix, "10.1.2")}.${leaf_id}/32
%{ endfor }

  ethernets:
%{ for self in [for d in GLOBAL.devices : d if contains(d.device_groups, "LEAFS") && d.variables.leaf_id == try(leaf_id, -1)] }
%{ for index, device in [for d in GLOBAL.devices : d if contains(d.device_groups, "SPINES")] }
    - id: 1/${index + try(leaf_fabric_interface_start, 1)}
      mtu: 9216
      switchport:
        enabled: false
      medium: p2p
      ip:
        unnumbered: lo0
%{ endfor }
%{ endfor }
%{ for self in [for d in GLOBAL.devices : d if contains(d.device_groups, "SPINES") && d.variables.spine_id == try(spine_id, -1)] }
%{ for index, device in [for d in GLOBAL.devices : d if contains(d.device_groups, "LEAFS")] }
    - id: ${floor(index / (try(spine_fabric_interface_max, 64) - try(spine_fabric_interface_start, 1) + 1)) + try(spine_fabric_module_start, 1)}/${index % (try(spine_fabric_interface_max, 64) - try(spine_fabric_interface_start, 1) + 1) + try(spine_fabric_interface_start, 1)}
      mtu: 9216
      switchport:
        enabled: false
      medium: p2p
      ip:
        unnumbered: lo0
%{ endfor }
%{ endfor }
