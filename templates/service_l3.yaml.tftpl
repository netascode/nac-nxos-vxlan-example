# L3 service: VRF with L3VNI, SVIs, EVPN
# Variables: name, vrf_id, vlans (list of id, ip_address)
# Optional: l3vni (default: l3vni_base + vrf_id), l3vni_base (default: 50000), l2vni_base (default: 30000), per-vlan vni override

vrfs:
  - name: ${name}
    vni: ${try(l3vni, try(l3vni_base, 50000) + vrf_id)}
    l3vni: true
    route_distinguisher: auto
    address_families:
      - address_family: ipv4-unicast
        route_target_both_auto: true
        route_target_both_auto_evpn: true

vlan:
  vlans:
%{ for vlan in vlans }
    - id: ${vlan.id}
      vn_segment: ${try(vlan.vni, try(l2vni_base, 30000) + vlan.id)}
      name: ${name}_${vlan.id}
%{ endfor }

interfaces:
  nve:
    vnis:
%{ for vlan in vlans }
      - vni: ${try(vlan.vni, try(l2vni_base, 30000) + vlan.id)}
%{ endfor }
  vlans:
%{ for vlan in vlans }
    - id: ${vlan.id}
      vrf: ${name}
      ip:
        address: ${vlan.ip_address}
      fabric_forwarding_mode: anycast-gateway
%{ endfor }

evpn:
  vnis:
%{ for vlan in vlans }
    - vni: ${try(vlan.vni, try(l2vni_base, 30000) + vlan.id)}
      rd: auto
      route_target_both_auto: true
%{ endfor }
